/* ===================================
   3. BIẾN GAME
=================================== */

const canvas=document.getElementById("gameCanvas");
const ctx=canvas.getContext("2d");

const W=960,H=540,GROUND=420;
let round=1,playing=false;
let lives=3,coins=0,helmet=false;
let keyFound=false,foundGirl=false;
let photoCount=0,giftCount=0;
let photoIndex=0;
let invincible=0,frame=0;
let camera=0;

let player={
 x:80,y:GROUND-90,w:60,h:85,
 vy:0,onGround:true,jumps:0
};

let obstacles=[],items=[],photoObjects=[],giftObjects=[];
let left=false,right=false,jump=false;
let lastTime=0;

/* ===================================
   4. TIỆN ÍCH
=================================== */

function screen(id){
 document.querySelectorAll(".screen").forEach(s=>s.classList.remove("active"));
 document.getElementById(id).classList.add("active");
}

function login(){
 if(document.getElementById("password").value!=="830807"){
  document.getElementById("error").textContent="Sai mật khẩu rồi ♡";
  return;
 }
 screen("intro");
 const m=document.getElementById("music");
 m.src=currentMusic;
 m.play().catch(()=>{});
}

function uploadCover(input){
 if(input.files[0]){
  document.getElementById("cover").src=URL.createObjectURL(input.files[0]);
 }
}

function uploadPhotos(input){
 [...input.files].slice(0,4).forEach((f,i)=>{
  photos[i]=URL.createObjectURL(f);
 });
 showUploadPreview();
}

function uploadVideos(input){
 [...input.files].slice(0,3).forEach((f,i)=>{
  videos[i]=URL.createObjectURL(f);
 });
 showUploadPreview();
}

function uploadMusic(input){
 if(input.files[0]){
  currentMusic=URL.createObjectURL(input.files[0]);
  const m=document.getElementById("music");
  m.src=currentMusic;
  m.play().catch(()=>{});
 }
}

function showUploadPreview(){
 document.getElementById("uploadPreview").innerHTML=
 [...photos].map(src=>`<img src="${src}">`).join("");
}

/* ===================================
   5. KHỞI TẠO ROUND
=================================== */

function startRound(n){
 round=n;
 lives=3;
 coins=0;
 helmet=false;
 keyFound=false;
 foundGirl=false;
 photoCount=0;
 giftCount=0;
 camera=0;
 invincible=0;
 frame=0;

 player.x=80;
 player.y=GROUND-90;
 player.vy=0;
 player.jumps=0;

 obstacles=[];
 items=[];
 photoObjects=[];
 giftObjects=[];

 // Hộp gỗ, cây và gai
 const layout=[
  ["box",350],["tree",560],["spike",780],
  ["box",990],["spike",1200],
  ["tree",1400],["spike",1620],
  ["box",1830],["spike",2040]
 ];

 layout.forEach(([type,x])=>{
  obstacles.push({type,x,hit:false});
 });

 // Xu
 [250,600,900,1150,1450,1750,1950].forEach((x,i)=>{
  items.push({
   type:"coin",x,y:GROUND-(i%2?130:70),taken:false
  });
 });

 // Nón bảo vệ
 items.push({
  type:"helmet",x:1050,y:GROUND-100,taken:false
 });

 // Chìa khóa cuối vòng
 items.push({
  type:"key",x:2200,y:GROUND-90,taken:false
 });

 // 4 ảnh Round 2
 if(round===2){
  for(let i=0;i<4;i++){
   photoObjects.push({
    x:420+i*440,
    y:i%2===0?125:175,
    taken:false,
    index:i
   });
  }
 }

 // 3 hộp quà Round 3
 if(round===3){
  giftObjects=[
   {x:550,y:GROUND-160,taken:false,index:0},
   {x:1150,y:GROUND-230,taken:false,index:1},
   {x:1750,y:GROUND-115,taken:false,index:2}
  ];
 }

 document.getElementById("roundTitle").textContent="ROUND "+round;
 updateHUD();
 screen("game");
 playing=true;
 lastTime=0;
 requestAnimationFrame(gameLoop);
}

/* ===================================
   6. GIAO DIỆN
=================================== */

function updateHUD(){
 document.getElementById("hearts").textContent=
 "❤️".repeat(lives)+"🤍".repeat(3-lives);

 document.getElementById("coins").textContent="🪙 "+coins;

 document.getElementById("helmet").textContent=
 helmet?"🪖 Đã có":"🪖 Chưa có";

 document.getElementById("progress").textContent=
 round===2?photoCount+"/4":
 round===3?giftCount+"/3":"🔑";
}

/* ===================================
   7. NỀN BA MÙA
=================================== */

function drawBackground(){
 let g=ctx.createLinearGradient(0,0,0,H);

 if(round===1){
  g.addColorStop(0,"#83d7f4");
  g.addColorStop(1,"#e5f5d6");
 }else if(round===2){
  g.addColorStop(0,"#ffae70");
  g.addColorStop(1,"#bd554a");
 }else{
  g.addColorStop(0,"#171947");
  g.addColorStop(1,"#70448d");
 }

 ctx.fillStyle=g;
 ctx.fillRect(0,0,W,H);

 if(round===3){
  for(let i=0;i<90;i++){
   ctx.fillStyle="#fff5d5";
   ctx.globalAlpha=.4+(i%3)*.2;
   ctx.beginPath();
   ctx.arc((i*137)%W,(i*71)%310,2,0,Math.PI*2);
   ctx.fill();
  }
  ctx.globalAlpha=1;
 }

 if(round===2){
  ctx.fillStyle="#ffdc89";
  ctx.beginPath();
  ctx.arc(780,150,65,0,Math.PI*2);
  ctx.fill();
 }

 if(round===1){
  ctx.fillStyle="#a5d59a";
  for(let i=0;i<8;i++){
   ctx.beginPath();
   ctx.arc(i*150-camera*.2%1200,350,80,Math.PI,0);
   ctx.fill();
  }
 }

 ctx.fillStyle=round===3?"#373052":
 round===2?"#744b45":"#70645d";
 ctx.fillRect(0,GROUND,W,H-GROUND);

 ctx.fillStyle=round===3?"#514274":
 round===2?"#df9664":"#74c96d";
 ctx.fillRect(0,GROUND+100,W,10);

 ctx.strokeStyle="#fff";
 ctx.lineWidth=4;
 ctx.setLineDash([22,18]);
 ctx.beginPath();
 ctx.moveTo(0,GROUND+55);
 ctx.lineTo(W,GROUND+55);
 ctx.stroke();
 ctx.setLineDash([]);
}

/* ===================================
   8. NHÂN VẬT
=================================== */

function drawCharacter(x,y,name,fallback){
 const im=images[name];

 if(im&&im.complete&&im.naturalWidth>0){
  ctx.drawImage(im,x,y,75,90);
 }else{
  ctx.font="65px Arial";
  ctx.fillText(fallback,x,y+70);
 }
}

function drawPlayer(){
 const x=player.x-camera;

 if(round===1){
  drawCharacter(x,player.y,"boy","🧑🏻");
 }else if(round===2){
  drawCharacter(x,player.y,"boy","🧑🏻");
  ctx.font="32px Arial";
  ctx.fillText("🏍️",x+5,player.y+85);
 }else{
  const im=images.couple;
  if(im&&im.complete&&im.naturalWidth>0){
   ctx.drawImage(im,x,player.y-5,120,95);
  }else{
   ctx.font="65px Arial";
   ctx.fillText("🏍️",x,player.y+75);
   ctx.font="30px Arial";
   ctx.fillText("🧑🏻",x+15,player.y+20);
   ctx.fillText("👩🏻",x+50,player.y+20);
  }
 }
}

/* ===================================
   9. VẬT CẢN
=================================== */

function drawObstacles(){
 obstacles.forEach(o=>{
  const x=o.x-camera;
  if(x<-100||x>W+100)return;

  if(o.type==="box"){
   ctx.fillStyle="#a9673f";
   ctx.fillRect(x,GROUND-60,65,60);
   ctx.strokeStyle="#70432d";
   ctx.lineWidth=4;
   ctx.strokeRect(x,GROUND-60,65,60);
   ctx.beginPath();
   ctx.moveTo(x,GROUND-60);
   ctx.lineTo(x+65,GROUND);
   ctx.moveTo(x+65,GROUND-60);
   ctx.lineTo(x,GROUND);
   ctx.stroke();
  }

  if(o.type==="tree"){
   ctx.fillStyle="#79533b";
   ctx.fillRect(x+28,GROUND-80,20,80);
   ctx.fillStyle="#39934c";
   ctx.beginPath();
   ctx.arc(x+38,GROUND-115,48,0,7);
   ctx.fill();
   ctx.fillStyle="#5ab75d";
   ctx.beginPath();
   ctx.arc(x+15,GROUND-130,28,0,7);
   ctx.fill();
  }

  if(o.type==="spike"){
   ctx.fillStyle="#fff5ee";
   ctx.beginPath();
   ctx.moveTo(x,GROUND);
   ctx.lineTo(x+30,GROUND-55);
   ctx.lineTo(x+60,GROUND);
   ctx.fill();
   ctx.strokeStyle="#d94b6c";
   ctx.lineWidth=4;
   ctx.stroke();
  }
 });
}

/* ===================================
   10. ĐỒ VẬT
=================================== */

function drawItems(){
 items.forEach(p=>{
  if(p.taken)return;
  const x=p.x-camera;
  if(x<-50||x>W+50)return;

  ctx.font="35px Arial";

  if(p.type==="coin")ctx.fillText("🪙",x,p.y);
  if(p.type==="helmet")ctx.fillText("🪖",x,p.y);
  if(p.type==="key")ctx.fillText("🗝️",x,p.y);
 });
}

/* ===================================
   11. ẢNH TREO ROUND 2
=================================== */

function drawPhotos(){
 photoObjects.forEach(p=>{
  if(p.taken)return;

  const x=p.x-camera;
  ctx.strokeStyle="#493448";
  ctx.lineWidth=4;
  ctx.beginPath();
  ctx.moveTo(x+65,0);
  ctx.lineTo(x+65,p.y);
  ctx.stroke();

  ctx.fillStyle="#fff8ee";
  ctx.fillRect(x,p.y,130,130);

  ctx.strokeStyle="#51394b";
  ctx.strokeRect(x,p.y,130,130);

  const im=new Image();
  im.src=photos[p.index];

  if(im.complete&&im.naturalWidth>0){
   ctx.drawImage(im,x+7,p.y+7,116,105);
  }else{
   ctx.fillStyle="#f0a8c5";
   ctx.fillRect(x+7,p.y+7,116,105);
   ctx.fillStyle="#fff";
   ctx.font="35px Arial";
   ctx.fillText("♡",x+48,p.y+68);
  }

  ctx.fillStyle="#51394b";
  ctx.font="11px Arial";
  ctx.fillText("OUR MEMORY "+(p.index+1),x+25,p.y+122);
 });
}

/* ===================================
   12. HỘP QUÀ ROUND 3
=================================== */

function drawGifts(){
 giftObjects.forEach(p=>{
  if(p.taken)return;

  const x=p.x-camera;
  ctx.fillStyle="#f18ab8";
  ctx.fillRect(x,p.y,65,58);

  ctx.fillStyle="#ffe9a5";
  ctx.fillRect(x+27,p.y,11,58);
  ctx.fillRect(x,p.y+22,65,10);

  ctx.fillStyle="#ffd2e5";
  ctx.fillRect(x+13,p.y-12,40,14);

  ctx.strokeStyle="#843f6d";
  ctx.lineWidth=4;
  ctx.strokeRect(x,p.y,65,58);

  ctx.font="22px Arial";
  ctx.fillStyle="#fff";
  ctx.fillText("♡",x+20,p.y+43);
 });
}

/* ===================================
   13. BẠN GÁI VÀ CỬA
=================================== */

const girlX=2500,doorX=2600;

function drawGirlAndDoor(){
 if(round===3)return;

 const gx=girlX-camera;
 drawCharacter(gx,GROUND-90,"girl","👩🏻");

 if(foundGirl){
  ctx.fillStyle="#fff";
  ctx.font="bold 24px Arial";
  ctx.fillText("FOUND YOU ♡",gx-40,GROUND-110);
 }

 const dx=doorX-camera;
 ctx.fillStyle="#805039";
 ctx.fillRect(dx,GROUND-150,85,150);
 ctx.fillStyle="#f5d7a0";
 ctx.fillRect(dx+12,GROUND-130,60,130);
 ctx.fillStyle="#b77c39";
 ctx.beginPath();
 ctx.arc(dx+60,GROUND-70,6,0,7);
 ctx.fill();
}

/* ===================================
   14. VẼ TOÀN BỘ
=================================== */

function drawGame(){
 drawBackground();
 drawObstacles();
 drawItems();

 if(round===2)drawPhotos();
 if(round===3)drawGifts();

 drawGirlAndDoor();
 drawPlayer();
}

/* ===================================
   15. VA CHẠM VÀ MẤT MẠNG
=================================== */

function loseLife(){
 if(invincible>0)return;

 if(helmet){
  helmet=false;
  invincible=65;
  updateHUD();
  document.getElementById("objective").textContent=
  "🪖 Nón bảo vệ đã đỡ một lần va chạm!";
  return;
 }

 lives--;
 invincible=65;
 updateHUD();

 if(lives<=0){
  playing=false;
  setTimeout(()=>{
   alert("Hết mạng rồi! Chơi lại round này nha ♡");
   startRound(round);
  },100);
 }
}

function collide(a,b){
 return a.x+a.w>b.x&&a.x<b.x+b.w&&
 a.y+a.h>b.y&&a.y<b.y+b.h;
}

function checkInteractions(){
 const px=player.x;
 const py=player.y;

 // Vật cản
 obstacles.forEach(o=>{
  if(o.hit)return;

  const w=o.type==="tree"?65:60;
  const h=o.type==="spike"?55:
  o.type==="tree"?90:60;

  const box={
   x:o.x,y:GROUND-h,w:w,h:h
  };

  const body={
   x:px+12,y:py+10,w:45,h:75
  };

  if(collide(body,box)){
   if(o.type==="spike"){
    loseLife();
   }else if(player.onGround){
    player.x=Math.max(0,player.x-4);
   }
  }
 });

 // Xu, nón, chìa khóa
 items.forEach(p=>{
  if(p.taken)return;

  if(Math.abs(px-p.x)<45&&
     Math.abs(py-p.y)<110){

   p.taken=true;

   if(p.type==="coin"){
    coins++;
   }

   if(p.type==="helmet"){
    helmet=true;
    document.getElementById("objective").textContent=
    "Đã nhặt nón bảo vệ!";
   }

   if(p.type==="key"){
    keyFound=true;
    document.getElementById("objective").textContent=
    "Đã tìm thấy chìa khóa! ♡";
   }

   updateHUD();
  }
 });

 // 4 ảnh Round 2
 if(round===2){
  photoObjects.forEach(p=>{
   if(!p.taken&&Math.abs(px-p.x)<80){
    p.taken=true;
    photoIndex=p.index;
    photoCount++;
    openPhoto(p.index);
   }
  });
 }

 // 3 hộp quà Round 3
 if(round===3){
  giftObjects.forEach(p=>{
   if(!p.taken&&Math.abs(px-p.x)<60&&
   Math.abs(py-p.y)<160){
    p.taken=true;
    giftCount++;
    openVideo(p.index);
   }
  });
 }

 // Gặp bạn gái
 if(round!==3&&keyFound&&!foundGirl&&
 Math.abs(px-girlX)<65){

  if(round===2&&photoCount<4){
   document.getElementById("objective").textContent=
   "Hãy xem đủ 4 ảnh trước nha ♡";
  }else{
   foundGirl=true;
   document.getElementById("objective").textContent=
   "FOUND YOU ♡ Cùng nhau tới cánh cửa!";
  }
 }

 // Qua cửa
 if(keyFound&&Math.abs(px-doorX)<65){
  if(round===1&&foundGirl)winRound();
  if(round===2&&foundGirl&&photoCount===4)winRound();
  if(round===3&&giftCount===3)winRound();
 }
}

/* ===================================
   16. HIỆU ỨNG ẢNH
=================================== */

function openPhoto(index){
 playing=false;

 const im=document.getElementById("memoryImage");
 im.src=photos[index];
 document.getElementById("photoNumber").textContent=
 "MEMORY "+(index+1)+" / 4";

 document.getElementById("photoModal").classList.add("show");
}

function nextPhoto(){
 document.getElementById("photoModal").classList.remove("show");

 if(photoCount===4){
  document.getElementById("objective").textContent=
  "Đã xem đủ 4 ảnh! Tìm chìa khóa và gặp bạn gái ♡";
 }

 playing=true;
 requestAnimationFrame(gameLoop);
}

/* ===================================
   17. VIDEO HỘP QUÀ
=================================== */

function openVideo(index){
 playing=false;

 const v=document.getElementById("memoryVideo");
 v.src=videos[index];
 document.getElementById("videoModal").classList.add("show");
 v.play().catch(()=>{});
}

function closeVideo(){
 const v=document.getElementById("memoryVideo");
 v.pause();
 v.removeAttribute("src");
 v.load();

 document.getElementById("videoModal").classList.remove("show");

 document.getElementById("objective").textContent=
 "Đã mở "+giftCount+"/3 hộp quà ♡";

 playing=true;
 requestAnimationFrame(gameLoop);
}

/* ===================================
   18. THẮNG VÀ MỞ THƯ
=================================== */

function winRound(){
 if(!playing)return;

 playing=false;

 document.getElementById("unlockText").textContent=
 "ROUND "+round+" COMPLETE ♡";

 screen("unlock");
}

function continueRound(){
 if(round===3){
  openLetter(2);
  return;
 }

 openLetter(round);
}

function openLetter(n){
 document.getElementById("letterTitle").textContent=
 "INCOMING MAIL • LETTER "+n;

 document.getElementById("letterContent").textContent=
 letters[n-1];

 document.getElementById("letterModal").classList.add("show");
}

function closeLetter(){
 document.getElementById("letterModal").classList.remove("show");

 if(round===3){
  screen("finish");
 }else{
  if(round===1){
   startRound(2);
  }else{
   startRound(3);
  }
 }
}

/* ===================================
   19. VÒNG LẶP GAME
=================================== */

function gameLoop(time){
 if(!playing)return;

 const dt=Math.min((time-lastTime)/16.67||1,2);
 lastTime=time;

 frame++;

 if(invincible>0)invincible--;

 const speed=round===1?4:
 round===2?5:3.5;

 if(left)player.x-=speed*dt;
 if(right)player.x+=speed*dt;

 player.x=Math.max(0,Math.min(2550,player.x));

 if(jump){
  if(player.onGround||player.jumps<2){
   player.vy=-13;
   player.onGround=false;
   player.jumps++;
  }
  jump=false;
 }

 player.vy+=.65*dt;
 player.y+=player.vy*dt;

 if(player.y>=GROUND-player.h){
  player.y=GROUND-player.h;
  player.vy=0;
  player.onGround=true;
  player.jumps=0;
 }else{
  player.onGround=false;
 }

 camera=Math.max(0,player.x-300);

 checkInteractions();

 drawGame();

 if(invincible>0&&Math.floor(frame/5)%2===0){
  ctx.fillStyle="#ffffff55";
  ctx.fillRect(player.x-camera,player.y,70,90);
 }

 if(playing)requestAnimationFrame(gameLoop);
}

/* ===================================
   20. ĐIỀU KHIỂN MÁY TÍNH
=================================== */

window.addEventListener("keydown",e=>{
 if(e.key==="ArrowLeft"||e.key==="a")left=true;
 if(e.key==="ArrowRight"||e.key==="d")right=true;
 if(e.key===" "||e.key==="ArrowUp")jump=true;
});

window.addEventListener("keyup",e=>{
 if(e.key==="ArrowLeft"||e.key==="a")left=false;
 if(e.key==="ArrowRight"||e.key==="d")right=false;
});

/* ===================================
   21. ĐIỀU KHIỂN ĐIỆN THOẠI
=================================== */

function holdButton(id,action){
 const b=document.getElementById(id);

 b.addEventListener("pointerdown",e=>{
  e.preventDefault();
  action(true);
 });

 ["pointerup","pointerleave","pointercancel"].forEach(ev=>{
  b.addEventListener(ev,e=>{
   e.preventDefault();
   action(false);
  });
 });
}

holdButton("left",v=>left=v);
holdButton("right",v=>right=v);

document.getElementById("jump").addEventListener("pointerdown",e=>{
 e.preventDefault();
 jump=true;
});

</script>
